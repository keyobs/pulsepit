# Copy this file to .env at the repository root.
PORT=3001
WEB_PORT=5173

# Optional server-side token for GitHub Actions reads (private repositories: Actions read).
# GITHUB_TOKEN=

# Optional: override ~/.config/pulsepit/config.json (or $XDG_CONFIG_HOME/pulsepit/config.json).
# CONFIG_PATH=/absolute/path/to/config.json

# Use an existing parent directory containing your Git repositories.
SCAN_PATH=/absolute/path/to/repositories

# For multiple directories, use a JSON array instead:
# SCAN_PATH='["/absolute/path/to/repositories","/another/directory"]'
